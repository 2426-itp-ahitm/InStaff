<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.InStaff" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/instaff_primary</item>
        <item name="colorPrimaryVariant">@color/instaff_primary_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/instaff_secondary</item>
        <item name="colorSecondaryVariant">@color/instaff_secondary</item>
        <item name="colorOnSecondary">@color/instaff_text</item>
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        <item name="android:windowBackground">@color/instaff_background</item>
        <item name="colorSurface">@color/instaff_surface</item>
        <item name="colorOnSurface">@color/instaff_text</item>
        <item name="materialCardViewStyle">@style/Widget.InStaff.CardView</item>
        <item name="textInputStyle">@style/Widget.InStaff.TextInputLayout</item>
    </style>

    <style name="Widget.InStaff.CardView" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">18dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/instaff_border</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Widget.InStaff.TextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/instaff_surface</item>
        <item name="boxCornerRadiusTopStart">16dp</item>
        <item name="boxCornerRadiusTopEnd">16dp</item>
        <item name="boxCornerRadiusBottomStart">16dp</item>
        <item name="boxCornerRadiusBottomEnd">16dp</item>
        <item name="boxStrokeColor">@color/instaff_primary</item>
        <item name="hintTextColor">@color/instaff_text_muted</item>
    </style>
</resources>
