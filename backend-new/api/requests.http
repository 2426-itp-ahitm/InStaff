### Get access token (client credentials)
POST http://localhost:8081/realms/demo/protocol/openid-connect/token
Content-Type: application/x-www-form-urlencoded

grant_type=client_credentials&
client_id=backend&
client_secret=backend-secret-instaff

> {% client.global.set("access_token", response.body.access_token); %}

### Get access token (password)
POST http://localhost:8081/realms/demo/protocol/openid-connect/token
Content-Type: application/x-www-form-urlencoded

grant_type=password&
client_id=frontend&
client_secret=backend-secret-instaff&
username=bernhard@penkner.com&
password=admin

> {% client.global.set("access_token", response.body.access_token); %}

###############################################
# EMPLOYEE
###############################################

### Get all employees
GET http://localhost:8080/api/employees
Authorization: Bearer {{access_token}}

###

### Get employee by ID
GET http://localhost:8080/api/employees/2
Authorization: Bearer {{access_token}}

###

### Get employee by Keycloak ID
GET http://localhost:8080/api/employees/keycloak/a1329681-9ac4-4627-a7d6-d29527a540b2
Authorization: Bearer {{access_token}}

###

### Get employees by role ID
GET http://localhost:8080/api/employees/role/1
Authorization: Bearer {{access_token}}

###

### Get employees by partial name
GET http://localhost:8080/api/employees/name/White Dan
Authorization: Bearer {{access_token}}

###

### Create new employee
POST http://localhost:8080/api/employees
Authorization: Bearer {{access_token}}
Content-Type: application/json

{
  "firstname": "John",
  "lastname": "Smith",
  "email": "john.smith@example.com",
  "telephone": "+43 987 654321",
  "password": "securePassword123",
  "birthdate": "1990-01-01",
  "isManager": false,
  "roles": [1, 2],
  "hourlyWage": 12.5,
  "address": "Example Street 123"
}

###

### Update employee
PUT http://localhost:8080/api/employees/1
Authorization: Bearer {{access_token}}
Content-Type: application/json

{
  "firstname": "Jane",
  "lastname": "Doe",
  "email": "jane.doe@example.com",
  "birthdate": "1992-05-14",
  "telephone": "+43 123 456789",
  "isManager": true,
  "roles": [1, 2],
  "hourlyWage": 14.5,
  "address": "Musterstrasse 12"
}

### Update alexander hahn
PUT http://localhost:8080/api/employees/2
Authorization: Bearer {{access_token}}
Content-Type: application/json

{
  "firstname": "Alexander",
  "lastname": "Hahn",
  "email": "a.hahn@example.com",
  "birthdate": "2001-11-09",
  "telephone": "65626625",
  "isManager": false,
  "roles": [2, 3],
  "hourlyWage": 20.0,
  "address": "Limesstraße 12, 4060 Leonding"
}

###

### Delete employee by ID
DELETE http://localhost:8080/api/employees/1
Authorization: Bearer {{access_token}}

###

### Assign role to employee
PUT http://localhost:8080/api/employees/3/assignrole/2
Authorization: Bearer {{access_token}}

###

### Remove role from employee
PUT http://localhost:8080/api/employees/3/removerole/2
Authorization: Bearer {{access_token}}


