###############################################
# SHIFTS
###############################################

### Get all shifts
GET http://localhost:8080/api/shifts
Authorization: Bearer {{access_token}}

###

### Get shift by ID
GET http://localhost:8080/api/shifts/1

###

### Get shifts by company ID
GET http://localhost:8080/api/shifts/company/1

###

### Get shifts by date
GET http://localhost:8080/api/shifts/date/2025-03-25

###

### Get shifts between dates
GET http://localhost:8080/api/shifts/betweendates/2025-03-25/2025-03-27

###

### Create new shift
POST http://localhost:8080/api/shifts
Authorization: Bearer {{access_token}}
Content-Type: application/json

{
  "shiftName": "Morning Shift",
  "startTime": "2026-03-20T06:00:00",
  "endTime": "2026-03-20T14:00:00",
  "companyId": 1
}

###

### Create shift with assignments
POST http://localhost:8080/api/shifts/create_with_assignments
Content-Type: application/json

{
  "shiftCreateDTO": {
    "startTime": "2026-03-20T06:00:00",
    "endTime": "2026-03-20T14:00:00",
    "companyId": 1
  },
  "assignmentCreateDTOs": [
    {
      "employee": 1,
      "role": 1
    }
  ]
}

###

### Delete shift by ID
DELETE http://localhost:8080/api/shifts/delete/1
Authorization: Bearer {{access_token}}


###############################################
# SHIFT TEMPLATES
###############################################

### Get all shift templates
GET http://localhost:8080/api/shift-templates

###

### Create new shift template
POST http://localhost:8080/api/shift-templates
Content-Type: application/json

{
  "shiftTemplateName": "Standard Morning",
  "companyId": 1,
  "templateRoles": [
    {
      "roleId": 1,
      "count": 2
    }
  ]
}

###

### Update shift template
PUT http://localhost:8080/api/shift-templates
Content-Type: application/json

{
  "id": 1,
  "shiftTemplateName": "Updated Morning Template",
  "companyId": 1,
  "templateRoles": [
    {
      "roleId": 1,
      "count": 3
    }
  ]
}

###

### Delete shift template by ID
DELETE http://localhost:8080/api/shift-templates/delete/1
