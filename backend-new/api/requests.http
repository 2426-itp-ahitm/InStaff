###############################################
# SHIFTS
###############################################

### Get all shifts
GET http://localhost:8080/api/shifts
Authorization: Bearer {{access_token}}

###

### Get shift by ID
GET http://localhost:8080/api/shifts/1
Authorization: Bearer {{access_token}}

###

### Get shifts by date
GET http://localhost:8080/api/shifts/date/2026-03-13
Authorization: Bearer {{access_token}}

###

### Get shifts between dates
GET http://localhost:8080/api/shifts/betweendates/2026-03-13/2026-03-27
Authorization: Bearer {{access_token}}

###

### Create new shift
POST http://localhost:8080/api/shifts
Authorization: Bearer {{access_token}}
Content-Type: application/json

{
  "shiftName": "Test Shift",
  "startTime": "2026-03-20T06:00:00",
  "endTime": "2026-03-20T14:00:00"
}

###

### Create shift with assignments
POST http://localhost:8080/api/shifts/create-with-assignments
Authorization: Bearer {{access_token}}
Content-Type: application/json

{
  "shiftCreateDTO": {
    "shiftName": "Test Shift",
    "startTime": "2026-03-20T06:00:00",
    "endTime": "2026-03-20T14:00:00"
  },
  "assignmentCreateDTOS": [
    {
      "employeeId": 1,
      "roleId": 1
    }
  ]
}

###

### Delete shift by ID
DELETE http://localhost:8080/api/shifts/1
Authorization: Bearer {{access_token}}


###############################################
# SHIFT TEMPLATES
###############################################

### Get all shift templates
GET http://localhost:8080/api/shift-templates
Authorization: Bearer {{access_token}}

###

### Create new shift template
POST http://localhost:8080/api/shift-templates
Authorization: Bearer {{access_token}}
Content-Type: application/json

{
  "shiftTemplateName": "Standard Morning",
  "templateRoles": [
    {
      "roleId": 1,
      "count": 2
    }
  ]
}

###

### Update shift template
PUT http://localhost:8080/api/shift-templates/4
Authorization: Bearer {{access_token}}
Content-Type: application/json

{
  "shiftTemplateName": "Updated Morning Template",
  "templateRoles": [
    {
      "roleId": 1,
      "count": 3
    },
    {
      "roleId": 2,
      "count": 1
    }
  ]
}

###

### Delete shift template by ID
DELETE http://localhost:8080/api/shift-templates/1
Authorization: Bearer {{access_token}}
