# Vorlage für die Secrets des persistenten Deployments.
# Auf dem Pi als ".env" kopieren und echte Werte eintragen:
#   cp .env.example .env  &&  nano .env
# docker compose liest .env automatisch. NICHT committen (steht in .gitignore).

# Passwort für die Keycloak-Postgres-Datenbank (nur alphanumerisch halten).
KC_DB_PASSWORD=change-me-db

# Keycloak Master-Admin (Admin-Console). Wird beim ersten Start einmalig angelegt.
KC_ADMIN=admin
KC_ADMIN_PASSWORD=change-me-strong
