### Get access token (client credentials)
POST http://localhost:8081/realms/instaff/protocol/openid-connect/token
Content-Type: application/x-www-form-urlencoded

grant_type=client_credentials&
client_id=backend&
client_secret=backend-secret-instaff

> {% client.global.set("access_token", response.body.access_token); %}

###############################################
# EMPLOYEE
###############################################

### Get all employees
GET http://localhost:8080/api/1/employees
Authorization: Bearer {{access_token}}

###

### Get employee by ID
GET http://localhost:8080/api/1/employees/1
Authorization: Bearer {{access_token}}

###

### Get employee by Keycloak ID
GET http://localhost:8080/api/1/employees/keycloak/your-keycloak-id-here
Authorization: Bearer {{access_token}}

###

### Get employees by role ID
GET http://localhost:8080/api/1/employees/role/1
Authorization: Bearer {{access_token}}

###

### Get employees by role name
GET http://localhost:8080/api/1/employees/role/name/Koch
Authorization: Bearer {{access_token}}

###

### Get employees by partial name
GET http://localhost:8080/api/1/employees/name/Jo
Authorization: Bearer {{access_token}}

###

### Get employees by company ID
GET http://localhost:8080/api/1/employees/company/1
Authorization: Bearer {{access_token}}

###

### Create new employee
POST http://localhost:8080/api/1/employees
Content-Type: application/json

{
  "firstname": "John",
  "lastname": "Smith",
  "email": "john.smith@example.com",
  "telephone": "+43 987 654321",
  "password": "securePassword123",
  "birthdate": "1990-01-01",
  "isManager": false,
  "companyId": 1,
  "roles": [1, 2],
  "hourlyWage": 12.5,
  "address": "Example Street 123"
}

###

### Update employee
POST http://localhost:8080/api/1/employees/1
Content-Type: application/json

{
  "firstname": "Jane",
  "lastname": "Doe",
  "email": "jane.doe@example.com",
  "birthdate": "1992-05-14",
  "telephone": "+43 123 456789",
  "isManager": false,
  "roles": [1, 2],
  "hourlyWage": 14.5,
  "address": "Musterstrasse 12"
}

###

### Delete employee by ID
DELETE http://localhost:8080/api/1/employees/delete/1

###

### Assign role to employee
PUT http://localhost:8080/api/1/employees/3/assignrole/2

###

### Remove role from employee
PUT http://localhost:8080/api/1/employees/3/removerole/2

###

### Assign employee to shift with role
PUT http://localhost:8080/api/1/employees/1/assignshift/3/1

###

### Unassign employee from shift
PUT http://localhost:8080/api/1/employees/1/unassignshift/3

###

### Login employee
PUT http://localhost:8080/api/1/employees/login/user@example.com/password123

###

### Login manager
PUT http://localhost:8080/api/1/employees/login-manager/manager@example.com/password123


###############################################
# ROLES
###############################################

### Get all roles
GET http://localhost:8080/api/1/roles
Authorization: Bearer {{access_token}}

###

### Get role by ID
GET http://localhost:8080/api/1/roles/1

###

### Get roles by company ID
GET http://localhost:8080/api/1/roles/company/1
Authorization: Bearer {{access_token}}

###

### Create new role
POST http://localhost:8080/api/1/roles
Authorization: Bearer {{access_token}}
Content-Type: application/json

{
  "roleName": "Supervisor",
  "companyId": 1,
  "description": "Supervises the shift"
}

###

### Update role
PUT http://localhost:8080/api/1/roles/update/1/Senior%20Supervisor

###

### Delete role by ID
DELETE http://localhost:8080/api/1/roles/remove/1


###############################################
# ASSIGNMENTS
###############################################

### Get all assignments
GET http://localhost:8080/api/1/assignments

###

### Get assignments by company ID
GET http://localhost:8080/api/1/assignments/company/1

###

### Get assignment by ID
GET http://localhost:8080/api/1/assignments/1

###

### Get assignments by shift ID
GET http://localhost:8080/api/1/assignments/shift/1

###

### Get assignments by employee ID
GET http://localhost:8080/api/1/assignments/employee/1

###

### Get assignments by employee ID between dates
GET http://localhost:8080/api/1/assignments/employee/1/2025-03-24/2025-03-27

###

### Confirm assignment
PUT http://localhost:8080/api/1/confirmation/confirm/1
Authorization: Bearer {{access_token}}

###

### Decline assignment
PUT http://localhost:8080/api/1/confirmation/decline/1
Authorization: Bearer {{access_token}}


###############################################
# SHIFTS
###############################################

### Get all shifts
GET http://localhost:8080/api/1/shifts
Authorization: Bearer {{access_token}}

###

### Get shift by ID
GET http://localhost:8080/api/1/shifts/1

###

### Get shifts by company ID
GET http://localhost:8080/api/1/shifts/company/1

###

### Get shifts by date
GET http://localhost:8080/api/1/shifts/date/2025-03-25

###

### Get shifts between dates
GET http://localhost:8080/api/1/shifts/betweendates/2025-03-25/2025-03-27

###

### Create new shift
POST http://localhost:8080/api/1/shifts
Authorization: Bearer {{access_token}}
Content-Type: application/json

{
  "shiftName": "Morning Shift",
  "startTime": "2026-03-20T06:00:00",
  "endTime": "2026-03-20T14:00:00",
  "companyId": 1
}

###

### Create shift with assignments
POST http://localhost:8080/api/1/shifts/create_with_assignments
Content-Type: application/json

{
  "shiftCreateDTO": {
    "startTime": "2026-03-20T06:00:00",
    "endTime": "2026-03-20T14:00:00",
    "companyId": 1
  },
  "assignmentCreateDTOs": [
    {
      "employee": 1,
      "role": 1
    }
  ]
}

###

### Delete shift by ID
DELETE http://localhost:8080/api/1/shifts/delete/1
Authorization: Bearer {{access_token}}


###############################################
# SHIFT TEMPLATES
###############################################

### Get all shift templates
GET http://localhost:8080/api/1/shift-templates

###

### Create new shift template
POST http://localhost:8080/api/1/shift-templates
Content-Type: application/json

{
  "shiftTemplateName": "Standard Morning",
  "companyId": 1,
  "templateRoles": [
    {
      "roleId": 1,
      "count": 2
    }
  ]
}

###

### Update shift template
PUT http://localhost:8080/api/1/shift-templates
Content-Type: application/json

{
  "id": 1,
  "shiftTemplateName": "Updated Morning Template",
  "companyId": 1,
  "templateRoles": [
    {
      "roleId": 1,
      "count": 3
    }
  ]
}

###

### Delete shift template by ID
DELETE http://localhost:8080/api/1/shift-templates/delete/1
